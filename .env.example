# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
# Set these in Netlify: Site configuration > Environment variables.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Local development only: point the site at the Firebase emulators.
# FIREBASE_USE_EMULATORS=1
# FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
