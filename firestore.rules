rules_version = '2';

// Quiz "مستويات أثرنا":
// - Anyone can CREATE exactly one valid submission per session (no update/overwrite).
// - Nobody can read submissions except signed-in admins listed in /admins/{uid}.
// - /admins is managed from the Firebase console only.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidSubmission(submissionId) {
      let d = request.resource.data;
      let fields = ['participantName', 'personality', 'recommendedField', 'scores', 'answers', 'submittedAt', 'sessionId'];
      let pairs = {
        'المخطط الأول': 'التخطيط والتحليل المالي، المحاسبة الإدارية',
        'النزيه': 'الحوكمة والامتثال',
        'حارس التفاصيل': 'المراجعة الداخلية والخارجية',
        'قارئ الأرقام': 'التحليل المالي، تقييم الأعمال',
        'كاشف الخفايا': 'المحاسبة الجنائية',
        'حلّال الأزمات': 'المحاسبة المالية، محاسبة التكاليف',
        'مايسترو الأنظمة': 'نظم المعلومات المحاسبية، أنظمة ERP',
        'خبير اللوائح': 'محاسبة الزكاة والضرائب',
        'قنّاص الفرص': 'محاسبة الاستثمار والصناديق، تقييم الأعمال',
        'صاحب الكلمة': 'المحاسبة القانونية، المراجعة الخارجية'
      };
      return d.keys().hasOnly(fields)
        && d.keys().hasAll(fields)
        && d.participantName is string
        && d.participantName.size() >= 2
        && d.participantName.size() <= 40
        && d.personality is string
        && d.personality in pairs
        && d.recommendedField == pairs[d.personality]
        && d.scores is map
        && d.scores.size() == 10
        && d.answers is list
        && d.answers.size() == 10
        && d.submittedAt == request.time
        && d.sessionId is string
        && d.sessionId == submissionId
        && d.sessionId.size() >= 16
        && d.sessionId.size() <= 64;
    }

    match /quiz_submissions/{submissionId} {
      // Creating an existing id is evaluated as an update and denied,
      // so a session can never be submitted twice.
      allow create: if isValidSubmission(submissionId);
      allow read: if isAdmin();
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
